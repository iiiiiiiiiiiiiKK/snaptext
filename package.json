{
  "name": "snaptext",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "SnapText - turn images into editable text. 100% in-browser OCR (Tesseract.js), no uploads, no accounts, no paid APIs.",
  "license": "MIT",
  "homepage": "https://iiiiiiiiiiiiiKK.github.io/snaptext/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iiiiiiiiiiiiiKK/snaptext.git"
  },
  "bugs": {
    "url": "https://github.com/iiiiiiiiiiiiiKK/snaptext/issues"
  },
  "keywords": [
    "ocr",
    "image-to-text",
    "tesseract",
    "tesseract.js",
    "chinese-ocr",
    "react",
    "vite",
    "tailwindcss",
    "privacy",
    "offline",
    "client-side"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "fixtures": "node scripts/make-fixtures.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "verify": "npm run lint && npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.50.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "fake-indexeddb": "^6.0.0",
    "globals": "^15.0.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.7"
  }
}
